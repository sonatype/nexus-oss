<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.sonatype.nexus.bundles</groupId>
    <artifactId>nexus-thirdparty-bundles</artifactId>
    <version>3.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>org.sonatype.nexus.bundles.ehcache</artifactId>
  <name>${project.groupId}:${project.artifactId}</name>
  <packaging>bundle</packaging>

  <description>
    Provides stripped down bundle of mvn:net.sf.ehcache:ehcache:${ehcache.version}.
  </description>

  <properties>
    <ehcache.version>2.10.0</ehcache.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>javax.transaction</groupId>
      <artifactId>javax.transaction-api</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <artifactItems>
            <artifactItem>
              <groupId>net.sf.ehcache</groupId>
              <artifactId>ehcache</artifactId>
              <version>${ehcache.version}</version>
              <outputDirectory>${project.build.directory}/generated-resources</outputDirectory>
              <includes>
                ehcache-failsafe.xml,
                net/sf/ehcache/**
              </includes>
              <excludes>
                **/*.class
              </excludes>
            </artifactItem>
            <artifactItem>
              <groupId>net.sf.ehcache</groupId>
              <artifactId>ehcache</artifactId>
              <version>${ehcache.version}</version>
              <classifier>sources</classifier>
              <outputDirectory>${project.build.directory}/generated-sources</outputDirectory>
              <includes>
                net/sf/ehcache/**,
                org/terracotta/context/**,
                org/terracotta/statistics/**
              </includes>
              <excludes>
                **/*ElementData*,
                **/scheduledrefresh/**,
                **/constructs/web/**,
                **/hibernate/*,
                **/hibernate/ccs/**,
                **/hibernate/management/api/**,
                **/hibernate/management/impl/EhcacheHibernate.*,
                **/hibernate/management/impl/*HibernateMBean*,
                **/hibernate/management/impl/Provider*,
                **/hibernate/management/impl/*Stats*,
                **/hibernate/nonstop/**,
                **/hibernate/regions/**,
                **/hibernate/strategy/**,
                **/management/AbstractManagementServer*,
                **/management/ManagementServerImpl*,
                **/management/resource/**,
                **/management/service/**,
                **/terracotta/Standalone*
              </excludes>
            </artifactItem>
          </artifactItems>
        </configuration>
        <executions>
          <execution>
            <id>unpack-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>unpack</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <configuration>
          <resources>
            <resource>
              <directory>${project.build.directory}/generated-resources</directory>
            </resource>
          </resources>
          <sources>
            <source>${project.build.directory}/generated-sources</source>
          </sources>
        </configuration>
        <executions>
          <execution>
            <id>add-unpacked-resources</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>add-resource</goal>
            </goals>
          </execution>
          <execution>
            <id>add-unpacked-sources</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>add-source</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <configuration>
          <instructions>
            <DynamicImport-Package>*</DynamicImport-Package>
          </instructions>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
