#set($raptureUrl="$baseUrl/static/rapture")

## TODO Consider adding a way to load prod app resources
## TODO but load extjs/baseapp debug resources seperatly for debugging optimized mode
## TODO potentially even move all css/js list generation into java code and simply render them asis here?
#if($debug)
  #set($resourceMode="debug")
#else
  #set($resourceMode="prod")
#end

<!DOCTYPE html>
<html>
<head>
  <title>Sonatype Nexus</title>

  <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
  <meta name="description" content="Sonatype Nexus"/>

  ## force browser to behave, IE=edge seems to have issues on IE 11 setting stylesheets (maybe other shit too)
  <meta http-equiv="X-UA-Compatible" content="IE=9,chrome=1"/>

  <link rel="icon" type="image/png" href="$raptureUrl/resources/favicon.png?$urlSuffix"/>
  <!--[if IE]>
  <link rel="SHORTCUT ICON" href="$raptureUrl/resources/favicon.ico?$urlSuffix"/>
  <![endif]-->

  #macro(style $src)
    <link rel="stylesheet" type="text/css" href="$src?$urlSuffix">
  #end

  #style("$raptureUrl/resources/loading-${resourceMode}.css")
  #style("$raptureUrl/resources/baseapp-${resourceMode}.css")

  ## TODO: load optimized/debug CSS for plugins
  #style("$raptureUrl/resources/nexus-rapture-plugin-${resourceMode}.css")
  #style("$raptureUrl/resources/nexus-coreui-plugin-${resourceMode}.css")
</head>
<body class="x-border-box">

<div id="loading-mask"></div>
<div id="loading">
  #macro(image $id $src)
    <img id="$id" src="$src?$urlSuffix"/>
  #end

  <div class="loading-indicator">
    #image("loading-image" "$raptureUrl/resources/images/loading.png")
    <br/>
    <div style="text-align: center;">
      #image("loading-spinner" "$raptureUrl/resources/images/loading-spinner.gif")
      <span id="loading-msg">Loading...</span>
    </div>
  </div>

  <div id="code-load" class="x-hide-display">
    #macro(message $text)
      <script type="text/javascript">
        console.log('$text');
        document.getElementById('loading-msg').innerHTML = '$text';
      </script>
    #end
    #macro(script $src)
      <script type="text/javascript" src="$src?$urlSuffix"></script>
    #end

    ## Load core extjs framework
    #message("Loading baseapp...")
    #script("$raptureUrl/baseapp-${resourceMode}.js")

    ## Load extensions
    #message("Loading extensions...")
    #script("$raptureUrl/extdirect-${resourceMode}.js")

    ## Load bootstrap
    #message("Loading bootstrap...")
    #script("$raptureUrl/bootstrap.js")

    ## TODO: load optimized shit
    ###message("Loading plugins...")
    ###script("$raptureUrl/nexus-rapture-plugin-${resourceMode}.js")
    ###script("$raptureUrl/nexus-coreui-plugin-${resourceMode}.js")

    ## Load application
    #message("Loading application...")
    #script("$raptureUrl/app.js")

    ## Finished
    #message("Initializing...")
  </div>
</div>

## Fields required for history management
<form id="history-form" class="x-hide-display">
  <input type="hidden" id="x-history-field"/>
  <iframe id="x-history-frame"></iframe>
</form>

</body>
</html>
